+@pytest.mark.parametrize("name", list(lineup.models()))
+@pytest.mark.parametrize("mode", ["throughput", "throughput_invariant"])
+def test_full_command_in_mode_has_each_flag_once_with_mode_value(name, mode):
+    """1.3.1: the FULL argv (profile extra_args included) under a mode, for every model."""
+    argv = serve.vllm_argv(name, python="py", mode=mode)
+    flags = [a for a in argv if a.startswith("--")]
+    assert len(flags) == len(set(flags)), flags
+    assert "--no-enable-prefix-caching" not in argv and "--enable-prefix-caching" in argv
+    i = argv.index("--max-num-seqs")
+    assert argv[i + 1] == "32", argv
+
+
+@pytest.mark.parametrize("name", list(lineup.models()))
+def test_strict_full_command_unchanged(name):
+    """Strict argv carries the profile's own flags exactly as 1.2.0 did (batch size 1, prefix cache off)."""
+    argv = serve.vllm_argv(name, python="py")
+    assert "--enable-prefix-caching" not in argv and "--no-enable-prefix-caching" in argv
+    assert argv[argv.index("--max-num-seqs") + 1] == "1"
