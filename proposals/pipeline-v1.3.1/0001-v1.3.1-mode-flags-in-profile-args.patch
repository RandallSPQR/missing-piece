+def _apply_mode_to_profile_args(extra: list[str], mode: str) -> list[str]:
+    """1.3.1 fix. A profile's serve.extra_args may itself carry determinism flags (the Qwen3.5 profiles set
+    `--max-num-seqs 1 --no-enable-prefix-caching`). In 1.3.0 a mode's replacement was applied only to the lineup's
+    determinism list, so a profile flag silently kept its strict value (Qwen ran at one sequence in flight under
+    `throughput`, found in Missing Piece S0-GPU). A non-strict mode now rewrites the same flags inside the profile's
+    args too, and drops the profile's copy of any flag the mode replaces, so each flag appears once with the mode's value.
+    Strict mode never calls this: its command is unchanged from 1.2.0."""
+    rep = ((lineup.lineup()["serving"].get("modes") or {}).get(mode) or {}).get("replace_flags") or {}
+    toks, out, i = list(extra), [], 0
+    while i < len(toks):
+        t = toks[i]
+        if t in rep:
+            nxt = toks[i + 1] if i + 1 < len(toks) and not toks[i + 1].startswith("--") else None
+            i += 2 if nxt is not None else 1            # drop the profile's flag (and its value); the mode's copy is added below
+            continue
+        out.append(t)
+        i += 1
+    return out
+
+
 def vllm_argv(name: str, python: str = VENV_PY, port: int = 8000, mode: str = "strict") -> list[str]:
     e = lineup.models()[name]
     prof = yaml.safe_load((lineup.CONFIG / e["profile"]).read_text())
@@ -46,6 +66,8 @@ def vllm_argv(name: str, python: str = VENV_PY, port: int = 8000, mode: str = "s
